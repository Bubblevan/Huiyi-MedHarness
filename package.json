{
  "name": "huiyi-medharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/",
    "fixtures/evidence.json",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run tests/collaboration-dsh-runner.test.ts tests/collaboration.test.ts tests/evidence.test.ts tests/locomo-dsh-lifecycle.test.ts tests/locomo-prompt.test.ts tests/memory.test.ts tests/rag.test.ts",
    "prepare": "pnpm build:core",
    "demo:dev": "pnpm --parallel --filter @huiyi/demo-gateway --filter @huiyi/demo-web dev",
    "demo:build": "pnpm --filter @huiyi/demo-gateway build && pnpm --filter @huiyi/demo-web build",
    "demo:test": "pnpm --filter @huiyi/demo-gateway test && pnpm --filter @huiyi/demo-web test",
    "demo:trace": "node scripts/demo/write-fixture-trace.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.1",
    "@types/node": "^22.15.30",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
