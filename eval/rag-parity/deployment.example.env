# Local, loopback-only HC-RAG-002 deployment. Copy to deployment.env locally;
# never commit that file. Both credential values are placeholders for a vLLM
# endpoint with no authentication.
QWEN_MODEL_PATH=/root/gpufree-share/data/Qwen3-8B
QWEN_MODEL_ID=Qwen3-8B
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_CONTEXT_WINDOW=40960
QWEN_RETRIEVAL_CONTEXT_TOKENS=14336
QWEN_MAX_OUTPUT_TOKENS=1024
QWEN_ENABLE_THINKING=0
QWEN_TOOL_CALL_PARSER=hermes
QWEN_GPU_MEMORY_UTILIZATION=0.80
QWEN_VLLM_ENFORCE_EAGER=1
QWEN_VLLM_BIN=/root/gpufree-data/Health-Copilot/training/posttrain/.venv/bin/vllm
HC_RAG_LOCAL_API_KEY=local-placeholder

HUIYI_HEALTH_ENGINE_URL=http://127.0.0.1:8322
HUIYI_RAG_ENABLED=1
HUIYI_RAG_BENCHMARK_ENABLED=1
HUIYI_RAG_CORPUS_ROOT=/root/gpufree-data/repro/hc-rag-002/corpus/prepared
HUIYI_RAG_MANIFEST_PATH=/root/gpufree-data/Huiyi-MedHarness/artifacts/hc-rag-002/corpus-manifest.json
HUIYI_RAG_QUERY_ENCODER_PATH=/root/gpufree-share/data/hf-cache/models--ncbi--MedCPT-Query-Encoder/snapshots/d83a36cc6b8e3a5c5e9d9d6ba156808c1643dcbc
HUIYI_RAG_TOKENIZER_PATH=/root/gpufree-share/data/Qwen3-8B
HUIYI_RAG_RETRIEVER_DEVICE=cpu
HUIYI_RAG_PLANNER_BASE_URL=http://127.0.0.1:8000/v1/chat/completions
HUIYI_RAG_PLANNER_MODEL=Qwen3-8B
HUIYI_RAG_PLANNER_API_KEY=local-placeholder
HUIYI_RAG_PLANNER_TIMEOUT_SECONDS=180
HUIYI_RAG_PLANNER_MAX_TOKENS=1024
HUIYI_RAG_BENCHMARK_CONTEXT_TOKENS=14336
