# Copy to an ignored local file (for example .env.rag) and source it when
# starting the shared health-engine. These values are deployment configuration.
HUIYI_RAG_ENABLED=1
HUIYI_HEALTH_ENGINE_HOST=127.0.0.1
HUIYI_HEALTH_ENGINE_PORT=8322
HUIYI_HEALTH_ENGINE_URL=http://127.0.0.1:8322

# Same self-hosted OpenAI-compatible local model used for query planning.
HUIYI_LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1/chat/completions
HUIYI_LOCAL_LLM_MODEL=Qwen/Qwen3-8B
HUIYI_RAG_PLANNER_BASE_URL=http://127.0.0.1:8001/v1/chat/completions
HUIYI_RAG_PLANNER_MODEL=Qwen/Qwen3-8B
HUIYI_RAG_PLANNER_API_KEY=local-placeholder
HUIYI_LOCAL_QWEN_API_KEY=local-placeholder
HUIYI_RAG_PLANNER_TIMEOUT_SECONDS=90
HUIYI_RAG_PLANNER_MAX_TOKENS=256

# Existing local small MedText sample. Runtime never downloads or builds assets.
HUIYI_RAG_CORPUS_ROOT=/root/gpufree-data/repro/imedrag-small-20261007/corpus
HUIYI_RAG_MANIFEST_PATH=/root/gpufree-data/Huiyi-MedHarness/artifacts/hc-rag-001/corpus-manifest.json
HUIYI_RAG_QUERY_ENCODER_PATH=/root/gpufree-share/data/hf-cache/models--ncbi--MedCPT-Query-Encoder/snapshots/d83a36cc6b8e3a5c5e9d9d6ba156808c1643dcbc
HUIYI_RAG_RETRIEVER_DEVICE=cpu
HUIYI_RAG_QUERY_MAX_LENGTH=512
HUIYI_RAG_TOKENIZER_PATH=/root/gpufree-share/data/Qwen3-8B

# Bounded product policy. The smoke corpus has 60 Textbooks + 33 StatPearls chunks.
HUIYI_RAG_DEFAULT_MODE=single
HUIYI_RAG_MAX_ROUNDS=2
HUIYI_RAG_MAX_QUERIES_PER_ROUND=2
HUIYI_RAG_CANDIDATES_PER_QUERY=3
HUIYI_RAG_MAX_RETURNED_EVIDENCE=3
HUIYI_RAG_MAX_EVIDENCE_TOKENS=2048
HUIYI_RAG_TIMEOUT_MS=180000
