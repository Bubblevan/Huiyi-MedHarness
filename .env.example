HUIYI_DEMO_BACKEND=fixture
HUIYI_DEMO_GATEWAY_PORT=8320
HUIYI_DEMO_API_BASE=/api

# Set on the Gateway host only after configuring its production runtime.
# Production forces the DSH backend and disables fixture patients/chats;
# chat stays unavailable until an authenticated patient-context adapter exists.
# HUIYI_APP_ENV=production

# Frontend environment defaults to Vite mode (development for `dev`, production for `build`).
# For a deliberately separate demo build use VITE_APP_ENV=demo. Production is the default build mode.
# VITE_APP_ENV=production
# Optional organization-facing label for a production build; can also be supplied at runtime.
# VITE_APP_ENV_LABEL=PROD

# Optional: native DSH with the local vLLM route (default model backend).
# HUIYI_DEMO_BACKEND=dsh
# HUIYI_DEMO_MODEL_BACKEND=vllm

# Optional: route native DSH to DeepSeek's hosted API.
# Put the real key in the ignored repository-root .env file; never commit it.
# HUIYI_DEMO_BACKEND=dsh
# HUIYI_DEMO_MODEL_BACKEND=deepseek-api
# DEEPSEEK_API_KEY=
# HUIYI_DEMO_DEEPSEEK_MODEL=deepseek-flash
