# Local Docker Desktop defaults. Copy to .env, then adjust as needed.
SITE_ADDRESS=localhost
CADDY_CONFIG=/etc/caddy/Caddyfile
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
EDGE_BIND_ADDRESS=127.0.0.1
HUIYI_PUBLIC_ORIGIN=https://localhost:8443
HUIYI_GATEWAY_UPSTREAM=http://host.docker.internal:8320
HUIYI_PUBLIC_ENVIRONMENT=临床评测环境
# Optional: set these to values reported by the active Gateway /api/health.
HUIYI_PUBLIC_PROVIDER=
HUIYI_PUBLIC_MODEL=
HUIYI_PUBLIC_VERSION=local
HUIYI_PUBLIC_AUDIT_URL=

# For a public Linux VPS, set SITE_ADDRESS to a DNS name and select the production Caddyfile:
# SITE_ADDRESS=demo.example.org
# CADDY_CONFIG=/etc/caddy/Caddyfile.production
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# EDGE_BIND_ADDRESS=0.0.0.0
# HUIYI_PUBLIC_ORIGIN=https://demo.example.org
# HUIYI_GATEWAY_UPSTREAM=http://10.77.0.2:8320
