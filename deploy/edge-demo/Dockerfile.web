FROM node:22-alpine AS web-build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/demo-web/package.json apps/demo-web/package.json
COPY apps/demo-web/ apps/demo-web/
RUN pnpm install --frozen-lockfile --filter @huiyi/demo-web...
RUN pnpm --filter @huiyi/demo-web clinical-evaluation:build

FROM caddy:2-alpine
COPY deploy/edge-demo/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /workspace/apps/demo-web/dist /srv
EXPOSE 80 443
