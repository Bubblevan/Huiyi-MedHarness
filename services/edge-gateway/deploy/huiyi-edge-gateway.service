[Unit]
Description=Huiyi lightweight Edge Gateway
After=network.target

[Service]
Type=simple
User=huiyi-edge
Group=huiyi-edge
EnvironmentFile=/etc/huiyi-edge-gateway.env
Environment=GOMEMLIMIT=128MiB
ExecStart=/usr/local/bin/huiyi-edge-gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/huiyi-edge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=multi-user.target
